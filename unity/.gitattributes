# Keep LF in Unity text files so Windows does not rewrite them (no LF/CRLF churn)
* text=auto
*.cs text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.json text eol=lf
*.inputactions text eol=lf
*.asmdef text eol=lf
*.shader text eol=lf
*.png binary
*.jpg binary
*.fbx binary
*.glb binary
*.wav binary
*.mp3 binary
*.ttf binary
